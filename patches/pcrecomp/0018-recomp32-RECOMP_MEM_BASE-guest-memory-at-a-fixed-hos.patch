From af3d9f27747e6e1ffb500921d68bdae0bf9a27ed Mon Sep 17 00:00:00 2001
From: Fernando Alves <67828493+fernandoalves25@users.noreply.github.com>
Date: Sun, 18 Oct 2026 23:29:05 +0000
Subject: [PATCH] recomp32: RECOMP_MEM_BASE -- guest memory at a fixed host
 address, the base a constant instead of a global reloaded after every guest
 store

---
 runtime/recomp32/recomp_types.h | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/runtime/recomp32/recomp_types.h b/runtime/recomp32/recomp_types.h
index a2a0ea5..cbfe75a 100644
--- a/runtime/recomp32/recomp_types.h
+++ b/runtime/recomp32/recomp_types.h
@@ -188,6 +188,13 @@ extern ptrdiff_t g_mem_base;
 /* Guest VAs ARE host addresses (a 32-bit host mapping each module at its own
  * base): nothing to add, and no global to reload on every access. */
 #define ADDR(va)     ((uintptr_t)(uint32_t)(va))
+#elif defined(RECOMP_MEM_BASE)
+/* The host maps guest memory at this fixed address (e.g. 0x100000000ull, with
+ * MAP_FIXED_NOREPLACE): the base is a constant the compiler keeps in a
+ * register. With the g_mem_base global, every guest store (an untyped byte
+ * array that may alias anything) forced a reload of the base before the next
+ * access. g_mem_base must still hold the same value for runtime code. */
+#define ADDR(va)     ((uintptr_t)(uint32_t)(va) + (uintptr_t)(RECOMP_MEM_BASE))
 #else
 #define ADDR(va)     ((uintptr_t)(uint32_t)(va) + g_mem_base)
 #endif
